    "z_evolve":      "power"
  },

  "param_overrides": {
    "gamma_alpha": {"active": true,  "fixed": null},
    "c0":          {"active": false, "fixed": 0.0},
    "sn_tau":      {"active": true,  "fixed": 0.3},
    "zeta":        {"active": true,  "fixed": 0.0},
    "F0":          {"active": true,  "fixed": -10.5},
    "ftau":        {"active": true,  "fixed": 0.5},
    "gamma":       {"active": false, "fixed": 0.0},
    "eta":         {"active": false, "fixed": 0.0},
    "alpha":       {"prior": "uniform"},
    "beta":        {"prior": "uniform"},
    "Om0":         {"prior": "uniform"}
  },

  "true_params": {
    "alpha":       0.15,
    "beta":        3.0,
